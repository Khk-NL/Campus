[Unit]
Description=Campus AI Gateway
After=network-online.target campus-pocketbase.service
Wants=network-online.target

[Service]
Type=simple
User=campus
Group=campus
WorkingDirectory=/opt/campus/ai-gateway
EnvironmentFile=/etc/campus/ai.env
# This host has IPv4 connectivity to ChatECNU; its IPv6 route times out.
ExecStart=/usr/bin/node --dns-result-order=ipv4first --no-network-family-autoselection /opt/campus/ai-gateway/src/server.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
