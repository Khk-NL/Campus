# 依赖提升策略 / dependency hoisting
strict-peer-dependencies=false
auto-install-peers=true

# pnpm 10+ 默认不执行生命周期脚本，这里显式放行需要构建的依赖。
# pnpm 10+ skips lifecycle scripts by default; allow the ones that need to build.
onlyBuiltDependencies:
  - '@nestjs/core'
  - '@prisma/client'
  - '@prisma/engines'
  - '@swc/core'
  - 'esbuild'
  - 'prisma'
  - 'unrs-resolver'

# 境内镜像（境外构建机请注释掉）/ China-mainland mirror; comment out elsewhere.
# registry=https://registry.npmmirror.com
