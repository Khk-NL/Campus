// Campus 数据模型 / Campus data model
//
// 同步纪律 / synchronisation discipline（§0.6）：
//   本文件是**唯一**的 schema 真源。绝不允许手工改数据库 —— 所有变更都必须经由
//   `prisma migrate dev` 生成 migration 并提交。因此本文件、migration 目录与
//   `@campus/models` 里的 TypeScript 类型必须同时更新。
//
//   This file is the single source of truth for the schema. Hand-editing the
//   database is forbidden: every change goes through `prisma migrate dev` and the
//   generated migration is committed. This file, the migrations directory and the
//   TypeScript types in `@campus/models` must therefore move together.
//
// 命名 / naming：TS 侧 camelCase，DB 侧 snake_case，由 @map 负责映射。
// TypeScript is camelCase, the database is snake_case, @map bridges the two.
//
// 刻意不用 JSON 列 / deliberately no JSON columns（§0.7）：
//   §6 把 `config` 与 `launch_config` 设计成未约束的 JSON。§0.7 禁止到处传未经约束的
//   JSON，因此这里把两者都展开成结构化列。代价是列变多，收益是数据库层也能拒绝
//   "web 类型却没有 url"这种非法组合。
//
//   §6 models `config` and `launch_config` as unconstrained JSON. §0.7 forbids that,
//   so both are expanded into structured columns here. More columns, but the database
//   can now reject illegal combinations such as "type = web with no url".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // 注意 / note: Prisma 7 起，连接串**不能**再写在这里。它现在配置在
  // `apps/api/prisma.config.ts` 的 `datasource.url`，而运行时的 Client 需要一个
  // driver adapter（见 src/prisma/prisma-client.factory.ts）。
  //
  // As of Prisma 7 the connection URL can no longer live here. It is configured in
  // `apps/api/prisma.config.ts` under `datasource.url`, and the runtime client needs a
  // driver adapter — see src/prisma/prisma-client.factory.ts.
}

// ---------------------------------------------------------------------------
// 共享枚举 / shared enums
//
// 每个枚举的取值都必须与 @campus/models 中同名的联合类型逐一对齐。
// Every enum value must line up one-to-one with the same-named union in @campus/models.
// ---------------------------------------------------------------------------

enum RecordStatus {
  draft
  active
  archived
  disabled
}

enum Role {
  user
  publisher
  developer
  moderator
  admin
}

enum ServiceCategory {
  official_hub
  academic
  library
  campus_card
  venue
  network
  map
  administration
  other
}

enum ServiceOrigin {
  official
  student_developed
  external
  open_source
}

enum ServiceSourceSystem {
  manual
  university_adapter
  developer_submission
  official_directory
}

enum LaunchTargetType {
  web
  wechat_mini_program
  native_app
  campus_app
}

enum WeekParity {
  all
  odd
  even
}

// ---------------------------------------------------------------------------
// University
// ---------------------------------------------------------------------------

model University {
  id        String       @id
  name      String
  shortName String       @map("short_name")
  domain    String
  logoUrl   String?      @map("logo_url")
  status    RecordStatus @default(active)

  // UniversityConfig 展开 / UniversityConfig, expanded (§0.7)
  termWeeks            Int      @map("term_weeks")
  periodsPerDay        Int      @map("periods_per_day")
  weekStartsOn         Int      @map("week_starts_on")
  timezone             String
  locales              String[] @default(["zh-CN", "en"])
  capabilities         String[] @default([])

  // 节次 → 时刻 / period to wall-clock mapping
  //
  // 两个字段而不是 JSON 列（§0.7）：真实课表的节次通常等长且连续，两字段覆盖绝大多数情况。
  // 已知局限：官方作息表里节间休息并不等长，因此第 2 节之后的时刻是近似值；
  // 客户端把这件事收在可替换的 PeriodSchedule 抽象后面，将来换成显式时刻表不必改调用方。
  //
  // Two columns rather than a JSON blob (§0.7). Known limitation: official schedules insert
  // uneven breaks, so periods after the first are approximate; the client hides this behind a
  // replaceable PeriodSchedule abstraction.
  firstPeriodStart String @default("08:00") @map("first_period_start")
  periodMinutes    Int    @default(45) @map("period_minutes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users    User[]
  services CampusService[]

  @@map("universities")
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id             String       @id @default(cuid())
  universityId   String       @map("university_id")
  externalUserId String       @map("external_user_id")
  name           String
  avatarUrl      String?      @map("avatar_url")
  roles          Role[]       @default([user])
  status         RecordStatus @default(active)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  // 同一所高校内学号唯一；跨校可重复，因此唯一键必须带 universityId。
  // A student number is unique within a university but not across universities, so
  // the unique key must include universityId.
  // 应用生态的反向关系 / back-relations for the app ecosystem（Prisma 要求关系双向）
  submittedApps CampusApp[]     @relation("AppSubmitter")
  developedApps CampusApp[]     @relation("AppDeveloper")
  appUsage      CampusAppUsage[]
  appLikes      CampusAppLike[]

  @@unique([universityId, externalUserId])
  @@index([universityId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// CampusService
// ---------------------------------------------------------------------------

model CampusService {
  id           String       @id @default(cuid())
  universityId String       @map("university_id")
  name         String
  description  String
  iconUrl      String?      @map("icon_url")
  category     ServiceCategory
  type         LaunchTargetType

  // LaunchTarget 展开 / LaunchTarget, expanded (§0.7)。
  // 每类目标只用到其中一部分列，合法性由 src/services/launch-target.mapper.ts 保证。
  // Each target kind uses a subset; legality is enforced in launch-target.mapper.ts.
  launchUrl           String? @map("launch_url")
  launchPreferredMode String? @map("launch_preferred_mode")
  launchOriginalId    String? @map("launch_original_id")
  launchPath          String? @map("launch_path")
  launchScheme        String? @map("launch_scheme")
  launchFallbackUrl   String? @map("launch_fallback_url")
  launchStoreUrl      String? @map("launch_store_url")
  launchAppId         String? @map("launch_app_id")
  launchRoute         String? @map("launch_route")

  isOfficial     Boolean             @default(false) @map("is_official")
  origin         ServiceOrigin
  sourceSystem   ServiceSourceSystem @map("source_system")
  sourceId       String?             @map("source_id")
  tags           String[]            @default([])
  lastVerifiedAt DateTime?           @map("last_verified_at")
  status         RecordStatus        @default(active)

  /// 被打开过多少次（与 campus_apps.open_count 同形）。学生应用与官方服务用同一口径记录
  /// 热度，不因为来源不同而一真一假。与 CampusApp 的三个计数一样，不合成一个热度分。
  /// Open counter, mirroring campus_apps.open_count so "heat" is real for both sources.
  openCount Int @default(0) @map("open_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  // Adapter 同步去重键 / the dedupe key used when an adapter re-syncs.
  @@unique([universityId, sourceId])
  @@index([universityId, category])
  @@index([universityId, status])
  @@map("campus_services")
}

// ---------------------------------------------------------------------------
// CampusApp —— 学生开发者生态（§13-Phase 3 / §18 / §27.9）
//
// 为什么需要这张表：Store 此前完全靠 mock 数据支撑，而投稿—审核、标签、探索、反馈、点赞
// 全部依赖后端持久化。因此它是这些功能的共同前置，不是"顺带做"。
//
// Why this table exists: the Store was backed entirely by mock data, while submission,
// review, tags, discovery, feedback and likes all need persistence. It is the shared
// prerequisite, not an afterthought.
//
// 设计依据见 docs/CAMPUS_APP_SCHEMA_DESIGN.md
// ---------------------------------------------------------------------------

enum CampusAppType {
  web
  github_pages
  website
  wechat_mini_program
  native_app
  external_project
}

/// §18 要求明确区分这四类，不得把学生项目包装成学校官方产品
enum CampusAppOrigin {
  official
  student_developed
  external
  open_source
}

enum ReviewStatus {
  draft
  pending_review
  approved
  rejected
  suspended
}

model CampusApp {
  id          String          @id @default(cuid())
  name        String
  description String
  iconUrl     String?         @map("icon_url")
  type        CampusAppType
  origin      CampusAppOrigin

  // 高校范围：判别联合的列式展开（§0.7 不用未约束 JSON）
  // UniversityScope, flattened into columns rather than an unconstrained JSON blob.
  scopeAll            Boolean  @default(false) @map("scope_all")
  scopeUniversityIds  String[] @default([]) @map("scope_university_ids")

  /// 关联仓库；§18 的「Repository 是否匹配」是审核项之一
  repositoryUrl String? @map("repository_url")

  /// P0：回到原始投稿（issue / 表单）的证据链接
  sourceUrl String? @map("source_url")

  /// P0 且不可后补：参考项目的投稿管道没存提交者，历史投稿一旦产生就永久丢失
  submitterId String? @map("submitter_id")

  /// 与 submitter 可以不同（学生替他人或团队项目投稿）
  developerId String? @map("developer_id")

  status ReviewStatus @default(draft)

  // LaunchTarget 展开，与 campus_services 同构，复用 launch-target.mapper.ts
  targetType          LaunchTargetType @map("target_type")
  launchUrl           String?          @map("launch_url")
  launchPreferredMode String?          @map("launch_preferred_mode")
  launchOriginalId    String?          @map("launch_original_id")
  launchPath          String?          @map("launch_path")
  launchScheme        String?          @map("launch_scheme")
  launchFallbackUrl   String?          @map("launch_fallback_url")
  launchStoreUrl      String?          @map("launch_store_url")
  launchAppId         String?          @map("launch_app_id")
  launchRoute         String?          @map("launch_route")

  /// 申请的权限（§15），固定取值由 @campus/models 的 Permission 约束
  permissions String[] @default([])
  screenshots String[] @default([])
  version     String   @default("0.0.0")

  /// 三个计数刻意分开，不合成"热度"——合成之后无法解释排序依据（§27.9）
  /// install / usage / like counters are kept apart on purpose.
  installCount Int       @default(0) @map("install_count")

  /// 被打开过多少次（`most-used` 排序依据）。与 installCount、likeCount 是三个互不相同的
  /// 计数，刻意不合成一个热度分（§27.9）。
  /// How many times the app was opened; distinct from installCount and likeCount.
  openCount    Int       @default(0) @map("open_count")
  lastVerifiedAt DateTime? @map("last_verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  submitter User? @relation("AppSubmitter", fields: [submitterId], references: [id], onDelete: SetNull)
  developer User? @relation("AppDeveloper", fields: [developerId], references: [id], onDelete: SetNull)

  usage CampusAppUsage[]

  /// 点赞的反向关系 / back-relation for likes（本轮只建表，不暴露接口）
  likes CampusAppLike[]

  /// 标签通过关联表而不是主表上的 String[]（见 §4 的归一化设计）
  /// Tags go through a link table rather than a String[] on this row.
  tagLinks CampusAppTagLink[]

  @@index([status])
  @@index([origin])
  @@index([type])
  @@map("campus_apps")
}

// ---------------------------------------------------------------------------
// 使用记录 / usage records
//
// 同时支撑三件事（§27.9）：每用户的「最近使用」（§11 明确要求）、全局使用次数、
// 以及失效检测的输入（一个入口反复打开失败是好信号）。
//
// Serves three purposes: per-user recency, aggregate usage count, and an input to
// staleness detection.
// ---------------------------------------------------------------------------

model CampusAppUsage {
  id     String @id @default(cuid())
  appId  String @map("app_id")
  userId String @map("user_id")

  useCount   Int      @default(0) @map("use_count")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  app  CampusApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, appId])
  @@index([appId])
  @@index([userId, lastUsedAt])
  @@map("campus_app_usage")
}

// ---------------------------------------------------------------------------
// 标签受控词表（§27.9 / CAMPUS_APP_SCHEMA_DESIGN.md §4）
//
// 为什么不是主表上的 String[]：参考项目正因为标签口径分裂而**静默丢失条目**——
// 大小写敏感的 trim 去重、没有别名、没有词表，同一个概念出现多套匹配口径。
// 受控词表 + 归一化键 + 别名表是唯一能真正阻止分裂的结构。
//
// Why not a String[] on the main row: the reference implementation silently loses entries to
// tag key splitting. A vocabulary with a normalised key and an alias table is the only
// structure that actually prevents it.
//
// 归一化函数（纯函数、可单测）在 @campus/models 的 normalizeTagName / resolveTag。
// The pure normalisation functions live in @campus/models.
// ---------------------------------------------------------------------------

/// 归并而非删除 / merge rather than delete, so history stays traceable
enum TagStatus {
  active
  merged
  deprecated
}

model CampusAppTag {
  id   String @id @default(cuid())
  name String

  /// 归一化键（trim → NFKC → 折叠空白 → 小写）。唯一索引落在它上面，这是阻止分裂的关键。
  /// The normalised key; the unique index sits here, which is what prevents splitting.
  normalizedName String    @unique @map("normalized_name")
  status         TagStatus @default(active)

  /// status = merged 时指向存活的标签 / the surviving tag when merged
  mergedIntoId String? @map("merged_into_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mergedInto CampusAppTag?  @relation("TagMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom CampusAppTag[] @relation("TagMerge")

  aliases CampusAppTagAlias[]
  links   CampusAppTagLink[]

  @@index([status])
  @@map("campus_app_tags")
}

model CampusAppTagAlias {
  id String @id @default(cuid())

  /// 别名同样存**归一化后**的形式，否则别名表自己就会分裂
  /// Aliases are stored normalised too, or the alias table splits in turn.
  normalizedAlias String @unique @map("normalized_alias")
  tagId           String @map("tag_id")

  createdAt DateTime @default(now()) @map("created_at")

  tag CampusAppTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([tagId])
  @@map("campus_app_tag_aliases")
}

model CampusAppTagLink {
  appId String @map("app_id")
  tagId String @map("tag_id")

  createdAt DateTime @default(now()) @map("created_at")

  app CampusApp   @relation(fields: [appId], references: [id], onDelete: Cascade)
  tag CampusAppTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([appId, tagId])
  @@index([tagId])
  @@map("campus_app_tag_links")
}

// ---------------------------------------------------------------------------
// 点赞 / likes
//
// 本轮只建表备用，不暴露任何点赞接口。之所以先建：`likeCount` 是与 installCount、
// openCount 并列的第三个计数（§27.9），三者互不相同、不合成热度分。
//
// The table is created now, with no like endpoints this round: likeCount is the third
// counter alongside installCount and openCount, and §27.9 keeps the three apart.
// ---------------------------------------------------------------------------

model CampusAppLike {
  id     String @id @default(cuid())
  appId  String @map("app_id")
  userId String @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")

  app  CampusApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 一个用户对一个应用最多一个赞 / at most one like per user per app
  @@unique([appId, userId])
  @@index([userId])
  @@map("campus_app_likes")
}
