# 依赖提升策略 / dependency hoisting
strict-peer-dependencies=false
auto-install-peers=true

# 注意 / note: 构建脚本许可（`allowBuilds`）**不在这里** —— pnpm 12 会忽略 .npmrc 中的
# 这份设置，必须写在 pnpm-workspace.yaml 里。见该文件的 `allowBuilds` 段。
# The build-script allowlist is deliberately NOT here: pnpm 12 ignores it in .npmrc. See
# the `allowBuilds` section of pnpm-workspace.yaml.

# 境内镜像（境外构建机请注释掉）/ China-mainland mirror; comment out elsewhere.
# registry=https://registry.npmmirror.com
