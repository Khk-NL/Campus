<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 访问 Campus 后端 REST 接口（用 dart-define 的 CAMPUS_API_BASE_URL 指向别处）。
         后端不可达时 App 会回退到内置演示数据，因此这条权限缺失也不会让 App 崩。

         注意：XML 注释里不允许出现连续两个连字符（XML 规范），所以这里不能照抄命令行
         里的写法，否则 Android 的 manifest merger 会以"Error parsing
         AndroidManifest.xml"直接失败。

         Needed to reach the Campus backend REST API, configurable through the
         CAMPUS_API_BASE_URL dart-define. When the backend is unreachable the app falls
         back to built-in demo data, so a missing permission never crashes it.

         Note: XML forbids a double hyphen inside a comment, so the command-line spelling
         cannot be copied verbatim here; doing so makes the Android manifest merger fail
         with "Error parsing AndroidManifest.xml". -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="Campulse"
        android:allowBackup="false"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- §7 Launcher 的 Phase 0 路径：把 Web 与 Deep Link 交给系统处理。
             §7's Phase 0 launcher path: hand web links and deep links to the system. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <!-- 微信：Android 11 起，没有这一段，canLaunchUrl(weixin://) 永远返回 false，
             而现象是"点了没反应"，根本看不出是包可见性问题。
             说明：这里声明的是"能查到微信"，不等于"能拉起小程序"。小程序唤起走微信
             OpenSDK，需要开放平台的移动应用 AppID，尚未申请（见 campus_launcher.dart 的
             MiniProgramTransport）。这一段必须先加上，因为它同时是"设备是否装了微信"的
             判断依据，用来把失败原因说清楚。

             WeChat: from Android 11 on, without this entry canLaunchUrl(weixin://) always
             answers false and the symptom is "nothing happens", with no hint that package
             visibility is the cause. Declaring it means "WeChat can be detected", NOT "mini
             programs can be launched": that needs an Open Platform AppID which has not been
             applied for yet. It is required now because the same probe tells the user whether
             WeChat is installed at all. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="weixin" />
        </intent>
        <package android:name="com.tencent.mm" />
    </queries>
</manifest>
